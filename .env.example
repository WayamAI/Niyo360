# PARIVART frontend configuration.
# Copy to .env.local and adjust. Never commit real secrets.

# Base URL of the PARIVART backend API, with no trailing slash.
# The client appends versioned paths itself (e.g. /api/v1/auth/login), so this
# is the origin only.
#
#   local backend      http://localhost:8010
#   deployed backend   https://api.parivart.example.com
#
# The backend must list this frontend's origin in its FRONTEND_ORIGIN setting
# or the browser will block every request on CORS.
VITE_API_BASE_URL=http://localhost:8010

# Demo sign-in. When true, an email the backend does not recognise is
# registered as a new organization instead of being rejected. That new
# organization is empty, so operational screens will show no rows. Leave unset
# or false for strict authentication.
VITE_DEMO_OPEN_SIGNIN=false
